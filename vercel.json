{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "redirects": [
    { "source": "/shop-os", "destination": "/blueprint-os", "permanent": true },
    { "source": "/shop-os/:path*", "destination": "/blueprint-os/:path*", "permanent": true },
    { "source": "/shop-ossi", "destination": "/blueprint-os", "permanent": true },
    { "source": "/shop-ossi/:path*", "destination": "/blueprint-os/:path*", "permanent": true },
    { "source": "/shop-os-preview", "destination": "/blueprint-os-preview", "permanent": true },
    { "source": "/shop-os-preview/:path*", "destination": "/blueprint-os-preview/:path*", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
